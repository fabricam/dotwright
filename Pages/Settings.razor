@page "/settings"
@using System.ComponentModel.DataAnnotations
@using Dotwright.Services
@inject ISettingsService SettingsService
@inject NavigationManager NavigationManager

<!--
  NOTE: This settings page stores the Playwright report path in browser localStorage.
  For server-side persistence implement an API (e.g., POST /api/settings/report-path) and call it here.
-->

<PageTitle>Settings</PageTitle>

<h3>Settings</h3>

<EditForm Model="@Model" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Playwright Report File Path</label>
        <InputText class="form-control" @bind-Value="Model.Path" />
        <div class="form-text">Blazor WASM cannot access local filesystem; only the path string is stored.</div>
    </div>

    <button class="btn btn-primary" type="submit">Save</button>
    <button class="btn btn-secondary ms-2" type="button" @onclick="Cancel">Cancel</button>
</EditForm>

@code {
    private SettingsModel Model { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Model.Path = await SettingsService.GetPlaywrightReportPathAsync() ?? string.Empty;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(Model.Path))
        {
            return;
        }

        await SettingsService.SetPlaywrightReportPathAsync(Model.Path);
        NavigationManager.NavigateTo("/");
    }

    private void Cancel() => NavigationManager.NavigateTo("/");

    private class SettingsModel
    {
        [Required]
        public string Path { get; set; } = string.Empty;
    }
}