@page "/"

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

<Accordion>
    @for(var i = 0; i < 3; i++)
    {
        <AccordionItem Title="Test Run">
            <Content>
                <div class="d-flex justify-content-between align-items-center w-100">
                    <span>2024-06-01 5:04 p.m.</span>
                    <div class="d-flex align-items-center gap-4">
                        <div class="metric-circle">
                            <Icon Name="IconName.CircleFill" Size="IconSize.x3" Color="IconColor.Success" />
                            <span class="metric-circle-value">2</span>
                        </div>
                        <div class="metric-circle">
                            <Icon Name="IconName.CircleFill" Size="IconSize.x3" Color="IconColor.Danger" />
                            <span class="metric-circle-value">3</span>
                        </div>
                        <div class="metric-circle">
                            <Icon Name="IconName.CircleFill" Size="IconSize.x3" Color="IconColor.Warning" />
                            <span class="metric-circle-value">3</span>
                        </div>
                    </div>
                </div>
            </Content>
        </AccordionItem>
    }
</Accordion>


