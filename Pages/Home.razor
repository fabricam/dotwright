@page "/"
@using System.IO
@using System.Linq
@using dotwright.Models
@using Dotwright.Services
@inject ISettingsService SettingsService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Dashboard</PageTitle>

<div class="d-flex justify-content-between align-items-center">
    <h1>Dashboard</h1>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-link" title="Toggle dark/light mode" @onclick="ToggleThemeAsync">
            <span class="bi @ThemeIconClass" aria-hidden="true"></span>
        </button>
        <button class="btn btn-link" title="Settings" @onclick="OpenSettings">
            <span class="bi bi-gear-fill" aria-hidden="true"></span>
        </button>
    </div>
</div>
<small class="text-body-secondary">@(_configuredPath ?? "Report path not configured")</small>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-warning mt-3" role="alert">
        @_loadError
    </div>
}

<Accordion>
    @foreach (var run in _runs)
    {
        <AccordionItem Title="@GetAccordionTitle(run)">
            <Content>
                @* Summary metrics row *@
                <div class="d-flex justify-content-between align-items-center w-100 mb-3">
                    <span class="text-body-secondary small">
                        Duration: <strong>@($"{run.Report.Stats.Duration / 1000.0:F1}s")</strong>
                        &nbsp;|&nbsp; Workers: <strong>@run.Report.Config.Workers</strong>
                        &nbsp;|&nbsp; Playwright <strong>@run.Report.Config.Version</strong>
                    </span>
                    <div class="d-flex align-items-center gap-4">
                        <div class="metric-circle" title="Passed">
                            <Icon Name="IconName.CircleFill" Size="IconSize.x3" Color="IconColor.Success" />
                            <span class="metric-circle-value">@run.Report.Stats.Expected</span>
                        </div>
                        <div class="metric-circle" title="Failed">
                            <Icon Name="IconName.CircleFill" Size="IconSize.x3" Color="IconColor.Danger" />
                            <span class="metric-circle-value">@run.Report.Stats.Unexpected</span>
                        </div>
                        <div class="metric-circle" title="Skipped">
                            <Icon Name="IconName.CircleFill" Size="IconSize.x3" Color="IconColor.Warning" />
                            <span class="metric-circle-value">@run.Report.Stats.Skipped</span>
                        </div>
                        <div class="metric-circle" title="Flaky">
                            <Icon Name="IconName.CircleFill" Size="IconSize.x3" Color="IconColor.Secondary" />
                            <span class="metric-circle-value">@run.Report.Stats.Flaky</span>
                        </div>
                    </div>
                </div>

                @* Projects row *@
                <div class="d-flex gap-2 mb-3">
                    @foreach (var project in run.Report.Config.Projects)
                    {
                        <span class="badge bg-secondary">@project.Name</span>
                    }
                </div>

                @* Per-test-file groups *@
                @foreach (var fileGroup in GetSpecsByFile(run.Report))
                {
                    <div class="mb-3 border border-secondary-subtle rounded p-3 bg-body-tertiary shadow-sm">
                        <div class="fw-semibold small text-body-secondary mb-2">
                            <Icon Name="IconName.FileEarmarkCode" Size="IconSize.None" />
                            @fileGroup.Key
                        </div>
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Test</th>
                                    <th>Browser</th>
                                    <th>Status</th>
                                    <th class="text-end">Duration</th>
                                    <th class="text-end">Retries</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var spec in fileGroup)
                                {
                                    @foreach (var test in spec.Tests)
                                    {
                                        @foreach (var result in test.Results)
                                        {
                                            <tr>
                                                <td>@spec.Title <span class="text-body-secondary small">L@(spec.Line)</span></td>
                                                <td><span class="badge text-bg-secondary">@test.ProjectName</span></td>
                                                <td>
                                                    @if (result.Status == "passed")
                                                    {
                                                        <Icon Name="IconName.CheckCircleFill" Color="IconColor.Success" />
                                                        <span class="text-success ms-1 small">passed</span>
                                                    }
                                                    else if (result.Status == "failed")
                                                    {
                                                        <Icon Name="IconName.XCircleFill" Color="IconColor.Danger" />
                                                        <span class="text-danger ms-1 small">failed</span>
                                                    }
                                                    else
                                                    {
                                                        <Icon Name="IconName.DashCircleFill" Color="IconColor.Warning" />
                                                        <span class="text-warning ms-1 small">@result.Status</span>
                                                    }
                                                </td>
                                                <td class="text-end small">@result.Duration ms</td>
                                                <td class="text-end small">@result.Retry</td>
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </Content>
        </AccordionItem>
    }
</Accordion>

@code {
    private string? _configuredPath;
    private string? _loadError;
    private List<PlaywrightReportSource> _runs = new();
    private string _theme = "light";
    private string ThemeIconClass => _theme == "dark" ? "bi-sun-fill" : "bi-moon-stars-fill";

    protected override async Task OnInitializedAsync()
    {
        _configuredPath = await SettingsService.GetPlaywrightReportPathAsync();
        _loadError = null;

        if (!string.IsNullOrWhiteSpace(_configuredPath))
        {
            try
            {
                _runs = (await dotwright.Services.PlaywrightReportReader.FromPathAsync(_configuredPath)).ToList();
            }
            catch (Exception ex)
            {
                _loadError = ex.Message;
                _runs = new();
            }
        }

        if (_runs.Count == 0 && string.IsNullOrWhiteSpace(_configuredPath))
        {
            _runs = MockRuns;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _theme = await JS.InvokeAsync<string>("dotwrightTheme.getTheme");
        await JS.InvokeVoidAsync("dotwrightTheme.setTheme", _theme);
        StateHasChanged();
    }

    private void OpenSettings() => NavigationManager.NavigateTo("/settings");

    private async Task ToggleThemeAsync()
    {
        _theme = _theme == "dark" ? "light" : "dark";
        await JS.InvokeVoidAsync("dotwrightTheme.setTheme", _theme);
    }

    private static string GetAccordionTitle(PlaywrightReportSource run)
    {
        var source = GetSourceLabel(run.SourcePath);
        return $"{source} — {run.Report.Stats.StartTime:yyyy-MM-dd h:mm tt}";
    }

    private static string GetSourceLabel(string sourcePath)
    {
        if (string.IsNullOrWhiteSpace(sourcePath))
        {
            return "Report";
        }

        if (Uri.TryCreate(sourcePath, UriKind.Absolute, out var uri))
        {
            return Path.GetFileName(uri.AbsolutePath.TrimEnd('/'));
        }

        return Path.GetFileName(sourcePath.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar));
    }

    private static IEnumerable<IGrouping<string, Spec>> GetSpecsByFile(PlaywrightReport report)
    {
        return report.Suites
            .SelectMany(suite => suite.Specs)
            .GroupBy(spec => string.IsNullOrWhiteSpace(spec.File) ? "Unknown file" : spec.File)
            .OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase);
    }

