@page "/"
@using Dotwright.Playwright.Models

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

<Accordion>
    @foreach (var run in MockRuns)
    {
        <AccordionItem Title="@($"{run.Config.Version} {run.Stats.StartTime:yyyy-MM-dd h:mm tt}")">
            <Content>
                @* Summary metrics row *@
                <div class="d-flex justify-content-between align-items-center w-100 mb-3">
                    <span class="text-muted small">
                        Duration: <strong>@($"{run.Stats.Duration / 1000.0:F1}s")</strong>
                        &nbsp;|&nbsp; Workers: <strong>@run.Config.Workers</strong>
                        &nbsp;|&nbsp; Playwright <strong>@run.Config.Version</strong>
                    </span>
                    <div class="d-flex align-items-center gap-4">
                        <div class="metric-circle" title="Passed">
                            <Icon Name="IconName.CircleFill" Size="IconSize.x3" Color="IconColor.Success" />
                            <span class="metric-circle-value">@run.Stats.Expected</span>
                        </div>
                        <div class="metric-circle" title="Failed">
                            <Icon Name="IconName.CircleFill" Size="IconSize.x3" Color="IconColor.Danger" />
                            <span class="metric-circle-value">@run.Stats.Unexpected</span>
                        </div>
                        <div class="metric-circle" title="Skipped">
                            <Icon Name="IconName.CircleFill" Size="IconSize.x3" Color="IconColor.Warning" />
                            <span class="metric-circle-value">@run.Stats.Skipped</span>
                        </div>
                        <div class="metric-circle" title="Flaky">
                            <Icon Name="IconName.CircleFill" Size="IconSize.x3" Color="IconColor.Secondary" />
                            <span class="metric-circle-value">@run.Stats.Flaky</span>
                        </div>
                    </div>
                </div>

                @* Projects row *@
                <div class="d-flex gap-2 mb-3">
                    @foreach (var project in run.Config.Projects)
                    {
                        <span class="badge bg-secondary">@project.Name</span>
                    }
                </div>

                @* Spec results table *@
                @foreach (var suite in run.Suites)
                {
                    <div class="mb-2">
                        <div class="fw-semibold small text-muted mb-1">
                            <Icon Name="IconName.FileEarmarkCode" Size="IconSize.None" />
                            @suite.File
                        </div>
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Test</th>
                                    <th>Browser</th>
                                    <th>Status</th>
                                    <th class="text-end">Duration</th>
                                    <th class="text-end">Retries</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var spec in suite.Specs)
                                {
                                    @foreach (var test in spec.Tests)
                                    {
                                        @foreach (var result in test.Results)
                                        {
                                            <tr>
                                                <td>@spec.Title <span class="text-muted small">L@(spec.Line)</span></td>
                                                <td><span class="badge bg-light text-dark border">@test.ProjectName</span></td>
                                                <td>
                                                    @if (result.Status == "passed")
                                                    {
                                                        <Icon Name="IconName.CheckCircleFill" Color="IconColor.Success" />
                                                        <span class="text-success ms-1 small">passed</span>
                                                    }
                                                    else if (result.Status == "failed")
                                                    {
                                                        <Icon Name="IconName.XCircleFill" Color="IconColor.Danger" />
                                                        <span class="text-danger ms-1 small">failed</span>
                                                    }
                                                    else
                                                    {
                                                        <Icon Name="IconName.DashCircleFill" Color="IconColor.Warning" />
                                                        <span class="text-warning ms-1 small">@result.Status</span>
                                                    }
                                                </td>
                                                <td class="text-end small">@result.Duration ms</td>
                                                <td class="text-end small">@result.Retry</td>
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </Content>
        </AccordionItem>
    }
</Accordion>

